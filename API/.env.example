# Copy this file to `.env` in the API directory and fill in secrets.
# `.env` is gitignored—never commit it.
#
# Activate prod first (required so application-prod.properties loads this file):
#   PowerShell:  $env:SPRING_PROFILES_ACTIVE = "prod"
#   Bash:        export SPRING_PROFILES_ACTIVE=prod
#
# Then run from API/:  ./mvnw spring-boot:run
#
# On a host (Render, Railway, Fly.io, etc.), set the same variables in the
# provider dashboard instead of using a .env file.

# Required — Supabase database password (Project Settings → Database)
DATABASE_PASSWORD=

# Optional overrides (defaults match your Supabase direct connection)
# DATABASE_URL=jdbc:postgresql://db.hqovvjvdzrzageebeecx.supabase.co:5432/postgres?sslmode=require
# DATABASE_USERNAME=postgres

# Socket.IO (set allowed origin to your deployed frontend)
SOCKET_SERVER_HOST=0.0.0.0
SOCKET_SERVER_PORT=8085
SOCKET_SERVER_ALLOWED_ORIGINS=https://JustinBoyce.github.io
